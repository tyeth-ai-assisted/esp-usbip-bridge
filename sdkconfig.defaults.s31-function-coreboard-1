CONFIG_IDF_TARGET="esp32s31"
CONFIG_USBIP_BOARD_ESPRESSIF_ESP32S31_FUNCTION_COREBOARD_1=y
CONFIG_USBIP_TRANSPORT_ETHERNET=y

# The board's UART USB-C connector goes through a CP2102N to UART0
# (GPIO58/59). USB Serial/JTAG is kept as a secondary console.
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_SECONDARY_USB_SERIAL_JTAG=y

CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y

# The esp-perfetto-logic components are only pulled in on esp32p4
# (main/idf_component.yml).
# CONFIG_USBIP_VIRTUAL_LOGIC_ANALYZER is not set

# Motorcomm YT8531 gigabit PHY over RGMII, with its own 25 MHz crystal (so no
# reference clock out of the S31). Pins are from the board schematic and match
# ETH_ESP32_EMAC_DEFAULT_CONFIG() for the ESP32-S31. The base sdkconfig.defaults
# carries P4HIL SMI pins, so every Ethernet pin is set explicitly here.
# PHYAD straps are left at their defaults (address 0); -1 auto-detects.
CONFIG_USBIP_ETH_INTERFACE_RGMII=y
CONFIG_USBIP_ETH_PHY_YT8531_INIT=y
CONFIG_USBIP_ETH_MDC_GPIO=5
CONFIG_USBIP_ETH_MDIO_GPIO=6
CONFIG_USBIP_ETH_PHY_ADDR=-1
CONFIG_USBIP_ETH_PHY_RST_GPIO=7
CONFIG_USBIP_ETH_RGMII_TX_CLK_GPIO=13
CONFIG_USBIP_ETH_RGMII_RX_CLK_GPIO=14
CONFIG_USBIP_ETH_RGMII_PHY_REF_CLK_GPIO=-1
CONFIG_USBIP_ETH_RGMII_TX_CTL_GPIO=12
CONFIG_USBIP_ETH_RGMII_TXD0_GPIO=8
CONFIG_USBIP_ETH_RGMII_TXD1_GPIO=9
CONFIG_USBIP_ETH_RGMII_TXD2_GPIO=10
CONFIG_USBIP_ETH_RGMII_TXD3_GPIO=11
CONFIG_USBIP_ETH_RGMII_RX_CTL_GPIO=15
CONFIG_USBIP_ETH_RGMII_RXD0_GPIO=19
CONFIG_USBIP_ETH_RGMII_RXD1_GPIO=18
CONFIG_USBIP_ETH_RGMII_RXD2_GPIO=17
CONFIG_USBIP_ETH_RGMII_RXD3_GPIO=16

# The USB-HS Type-A host port has no on-board hub and its VBUS switch
# (TPS2051C) is hard-wired on, so no power-enable GPIO is needed.

# WS2812 via a non-inverting BSS138 level shifter
CONFIG_USBIP_NEOPIXEL_GPIO=60

# In-package 1.8 V octal PSRAM (ESP32-S31-WROOM-3 on this board: ESP32-S31NRV16,
# 16 MB, AP Memory gen 4). The module datasheet (v0.7, Table 6-11) rates its
# maximum clock at 200 MHz or more; 250 MHz is offered by IDF but is above that.
# IGNORE_NOTFOUND keeps a board without PSRAM bootable.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_200M=y
CONFIG_SPIRAM_IGNORE_NOTFOUND=y

# The PSRAM driver takes the MPLL (400 MHz at the PSRAM speeds above), from
# which the RGMII TX clock cannot make 125 MHz ("EMAC out frequency cannot be
# used", network init aborts). Clock RGMII from the APLL instead.
CONFIG_ETH_EMAC_RGMII_TX_CLK_SRC_APLL=y
